DB_CONNECTION_STRING=YOUR_CONNECTION_STRING
DB_PASSWORD=YOUR_PASSWORD
JWT_SECRET=YOUR_RANDOM_SECRET_KEY_HERE
ALLOWED_ORIGINS=YOUR_ALLOWED_ORIGINS
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

SCRIPT_MODEL=MODEL_NAME
SCRIPT_API_KEY=YOUR_API_KEY
SCRIPT_BASE_URL=YOUR_BASE_URL
VIDEO_API_KEY=YOUR_API_KEY
# Clip length for OpenAI video API: 4, 8, or 12 (default 12). Script beat template and audio guards follow this value automatically.
VIDEO_SECONDS=12

# Google Veo (Gemini Developer API) — optional second video backend; Grok picks Sora vs Veo per script.
# Set to false to disable Veo and always use Sora (VIDEO_API_KEY) even when Gemini keys are set.
# VEO_GENERATION_ENABLED=true
# Use one of: GOOGLE_VEO_API_KEY, GOOGLE_API_KEY, or GEMINI_API_KEY (first non-empty wins).
# GOOGLE_VEO_API_KEY=YOUR_API_KEY
# GEMINI_API_KEY=YOUR_API_KEY
# GOOGLE_VEO_MODEL=veo-3.1-generate-preview
# Must stay unset for the built-in Veo path (Vertex/GCS flows are not supported here):
# GOOGLE_GENAI_USE_VERTEXAI=

# Azure Blob Storage (for ad videos)
AZURE_STORAGE_CONNECTION_STRING=YOUR_AZURE_STORAGE_CONNECTION_STRING
AZURE_STORAGE_VIDEO_CONTAINER=ad-videos

# Resend (for email verification)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=15

# Meta (Facebook/Instagram) — set after registering your Meta App
# developers.facebook.com > Your App > Settings > Basic
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
# Must match "Valid OAuth Redirect URIs" registered in the Meta App dashboard
META_REDIRECT_URI=https://yourapi.com/social-auth/callback
# Frontend URL to redirect to after OAuth callback (local dev default in code is http://localhost:3000)
META_FRONTEND_URL=https://yourapp.com

# TikTok (Marketing API) — set after creating your TikTok For Business app
# business-api.tiktok.com/portal > Your App > App Details
TIKTOK_APP_ID=YOUR_TIKTOK_APP_ID
TIKTOK_APP_SECRET=YOUR_TIKTOK_APP_SECRET
# Must match the Advertiser Authorization URL registered in the TikTok App portal
TIKTOK_REDIRECT_URI=https://yourapi.com/api/tiktok/callback
# Frontend URL to redirect to after OAuth callback (local dev default in code is http://localhost:3000)
TIKTOK_FRONTEND_URL=https://yourapp.com
# API base URL — defaults to sandbox in code; switch to production once verified.
#   Sandbox:    https://sandbox-ads.tiktok.com/open_api/v1.3
#   Production: https://business-api.tiktok.com/open_api/v1.3
# Sandbox does not support oauth so we default to using prod endpoint instead
TIKTOK_API_BASE_URL=https://sandbox-ads.tiktok.com/open_api/v1.3
# Authorize portal URL (rarely changes; override only if TikTok moves it)
# TIKTOK_AUTH_PORTAL_URL=https://business-api.tiktok.com/portal/auth

# Fernet symmetric encryption key for storing OAuth tokens at rest.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=YOUR_FERNET_KEY

# Daily credits for ad generation (10 free / 100 subscription per UTC day)
CREDITS_ENFORCE=true
